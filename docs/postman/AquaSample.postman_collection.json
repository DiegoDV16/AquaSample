          ],
          "path": [
            "v1",
            "marine"
          ],
          "query": [
            {
              "key": "latitude",
              "value": "-35.9"
            },
            {
              "key": "longitude",
              "value": "-72.9"
            },
            {
              "key": "current",
              "value": "wave_height,sea_surface_temperature,wind_speed_10m"
            }
          ],
          "protocol": "https"
        },
        "description": "Consulta las condiciones marinas (oleaje, temperatura del mar y viento) mediante la Open-Meteo Marine API."
      }
