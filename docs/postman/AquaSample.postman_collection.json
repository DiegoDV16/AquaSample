      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://marine-api.open-meteo.com/v1/marine?latitude=-35.9&longitude=-72.9&current=wave_height,sea_surface_temperature,wind_speed_10m",
